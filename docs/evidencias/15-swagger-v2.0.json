{
  "openapi": "3.0.1",
  "info": {
    "title": "Recommenda API",
    "description": "API REST para descoberta musical: gerenciamento de artistas, albuns, faixas, generos e avaliacoes de usuarios. Versao atual. GET /api/album devolve envelope paginado (page, pageSize, totalItems, totalPages, items).",
    "contact": {
      "name": "Equipe Recommenda",
      "email": "contato@recommenda.example.com"
    },
    "version": "2.0"
  },
  "paths": {
    "/api/Album": {
      "get": {
        "tags": [
          "Album"
        ],
        "summary": "[v2] Lista albuns paginados, ordenados por titulo.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Pagina (base 1). Padrao 1.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "Itens por pagina, de 1 a 100. Padrao 20.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20
            }
          },
          {
            "name": "api-version",
            "in": "query",
            "description": "The requested API version",
            "schema": {
              "type": "string",
              "default": "2.0"
            }
          },
          {
            "name": "X-Api-Version",
            "in": "header",
            "description": "The requested API version",
            "schema": {
              "type": "string",
              "default": "2.0"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlbumResponsePagedResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Album"
        ],
        "summary": "Cria um novo album para um artista existente. Limite: 10 requisicoes por minuto por IP.",
        "description": "Exemplo de corpo:\r\n            \r\n    POST /api/album\r\n    {\r\n        \"title\": \"No na Orelha\",\r\n        \"releaseDate\": \"2011-07-12T00:00:00\",\r\n        \"artistId\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\r\n        \"coverUrl\": \"https://example.com/capa.jpg\"\r\n    }",
        "parameters": [
          {
            "name": "api-version",
            "in": "query",
            "description": "The requested API version",
            "schema": {
              "type": "string",
              "default": "2.0"
            }
          },
          {
            "name": "X-Api-Version",
            "in": "header",
            "description": "The requested API version",
            "schema": {
              "type": "string",
              "default": "2.0"
            }
          }
        ],
        "requestBody": {
          "description": "Dados do album a ser criado.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AlbumRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/AlbumRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/AlbumRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlbumResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
