    "/api/AlbumRating": {
      "post": {
        "tags": [
          "AlbumRating"
        ],
        "summary": "Registra a avaliacao de um usuario sobre um album. Limite: 10 requisicoes por minuto por IP.",
        "description": "Cada usuario pode avaliar um album apenas uma vez. Score deve estar entre 1 e 5.\r\n            \r\n    POST /api/albumrating\r\n    {\r\n        \"userId\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\r\n        \"albumId\": \"7fa85f64-5717-4562-b3fc-2c963f66afa6\",\r\n        \"score\": 5,\r\n        \"comment\": \"Album incrivel!\"\r\n    }",
        "requestBody": {
          "description": "Dados da avaliacao.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AlbumRatingRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/AlbumRatingRequest"
              }
